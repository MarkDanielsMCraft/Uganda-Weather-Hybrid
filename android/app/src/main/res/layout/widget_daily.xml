<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_daily_district"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kampala"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 Day Forecast"
            android:textColor="#98A8BD"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#18FFFFFF"
        android:contentDescription="@null" />

    <!-- 5 Horizontal Rows with Range Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Day 0 (Today) -->
        <LinearLayout
            android:id="@+id/widget_daily_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_daily_day_0"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/widget_daily_icon_0"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_weather_sun"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_rain_0"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="30%"
                android:textColor="#86CCF2"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_daily_low_0"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="19°"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_bar_0"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_range_bar_today"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_high_0"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="28°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 1 -->
        <LinearLayout
            android:id="@+id/widget_daily_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_daily_day_1"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Tue"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_icon_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_weather_cloud"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_rain_1"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="40%"
                android:textColor="#86CCF2"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_daily_low_1"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="19°"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_bar_1"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_range_bar"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_high_1"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="27°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:id="@+id/widget_daily_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_daily_day_2"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Wed"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_icon_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_weather_rain"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_rain_2"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="70%"
                android:textColor="#86CCF2"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_daily_low_2"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="18°"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_bar_2"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_range_bar"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_high_2"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="26°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:id="@+id/widget_daily_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_daily_day_3"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Thu"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_icon_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_weather_cloud"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_rain_3"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="20%"
                android:textColor="#86CCF2"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_daily_low_3"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="19°"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_bar_3"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_range_bar"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_high_3"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="28°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 4 -->
        <LinearLayout
            android:id="@+id/widget_daily_row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_daily_day_4"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Fri"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_icon_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_weather_sun"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_rain_4"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="10%"
                android:textColor="#86CCF2"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/widget_daily_low_4"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="20°"
                android:textColor="#98A8BD"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/widget_daily_bar_4"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_range_bar"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_daily_high_4"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="29°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
