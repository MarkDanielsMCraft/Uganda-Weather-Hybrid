<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Azure Equatorial Sky Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0F2847"
                android:centerColor="#09182C"
                android:endColor="#040B15" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#25FFFFFF" />
        </shape>
    </item>

    <!-- Warm Radiant Amber Solar Corona Aura (Top Right) -->
    <item
        android:gravity="top|end"
        android:width="220dp"
        android:height="170dp"
        android:top="-30dp"
        android:right="-30dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:startColor="#305AC8FA"
                android:centerColor="#105AC8FA"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Subtle Top Glass Surface Sheen -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp"
        android:left="22dp"
        android:right="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
        </shape>
    </item>
</layer-list>
