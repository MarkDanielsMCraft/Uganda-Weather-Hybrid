<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Obsidian Midnight Deep Space Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#090E17"
                android:centerColor="#05080E"
                android:endColor="#020306" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#1EFFFFFF" />
        </shape>
    </item>

    <!-- Celestial Lunar Starlight Glow (Top Right) -->
    <item
        android:gravity="top|end"
        android:width="200dp"
        android:height="160dp"
        android:top="-30dp"
        android:right="-30dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#2082B1FF"
                android:centerColor="#082979FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Subtle Top Glass Surface Sheen -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="1dp"
        android:left="22dp"
        android:right="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
