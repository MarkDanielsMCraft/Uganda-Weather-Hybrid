# Environment variables for Uganda Weather
# Copy to .env.local and fill in values

# ─── Required ───────────────────────────────────────────────

# WeatherAPI.com, https://www.weatherapi.com/my/
# Primary provider when set. Falls back to Open-Meteo (free, no key) on timeout/error.
WEATHERAPI_KEY=

# Request timeouts in milliseconds (sequential, never both providers at once)
# WEATHER_PRIMARY_TIMEOUT_MS=5000
# WEATHER_FALLBACK_TIMEOUT_MS=8000

# App URL (no trailing slash). Used for canonical links, the sitemap,
# robots.txt, and OpenGraph image URLs. Set this to the real production
# domain when deploying, for example https://www.uganda-weather.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Capacitor native shell loads this URL (dev or production deploy)
# CAPACITOR_SERVER_URL=https://www.uganda-weather.com

# ─── Map tiles (required for the Map and Precipitation features) ──────

# MapTiler, primary base map tile provider. tile.openstreetmap.org blocks
# this app for violating their tile usage policy (embedding a raw tile
# server in a live product), so a policy-compliant, key-gated provider is
# required. Free tier: 100k tile loads/month. Client-visible by design
# (loaded in <img src>), so restrict the key by domain in MapTiler's own
# dashboard rather than treating it as a server secret.
# https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_API_KEY=

# Stadia Maps, secondary fallback if a MapTiler tile request fails. Same
# client-visible, domain-restricted key model as above.
# https://client.stadiamaps.com/dashboard/#/keys
NEXT_PUBLIC_STADIA_MAPS_API_KEY=

# ─── Database ────────────────────────────────────────────────
# Not used. The original design called for Neon PostgreSQL (see
# docs/06-data-model.md), but districts ship as a bundled JSON file
# (data/districts/uganda-districts.json) and weather/alerts are
# cache-only (Redis, with an in-memory fallback), nothing is persisted
# to a database in the current implementation. No DATABASE_URL needed
# to deploy.

# ─── Cache (required for production) ────────────────────────

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The Vercel Upstash integration also supplies
# UPSTASH_REDIS_REST_KV_REST_API_URL and
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN; the app accepts either pair.

# ─── Optional ───────────────────────────────────────────────

# Cron prefetch (Vercel sets Authorization: Bearer automatically when configured)
# CRON_SECRET=
# FIREBASE_SERVER_KEY=
# PUSH_DISPATCH_SECRET=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_ACCESS_TOKEN=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_TOPIC=com.ugandaweather.app

# UNMA official alerts feed
# UNMA_ALERTS_URL=
# RAINVIEWER_API_KEY=

# Pirate Weather, third weather chain fallback tier, tried only when both
# WeatherAPI.com and Open-Meteo fail for the same request. Free tier: 20k
# calls/month, no card required, permanent. Guarded in code at 19,000/month.
# https://pirate-weather.apiable.io/
# PIRATE_WEATHER_API_KEY=

# OpenWeatherMap, Air Quality pollutant breakdown (CO, NO2, O3, PM10, PM2.5)
# shown in the Air Quality tile's detail view. Free tier: 1M calls/month, no
# card required. Only called when a user opens that tile, so volume stays
# low regardless of the generous cap.
# https://openweathermap.org/api
# OPENWEATHERMAP_API_KEY=

# Visual Crossing, historical averages tile ("today vs. typical high").
# Free tier: 1,000 records/day, plain API key, no billing account. Verified
# directly against their docs: normal.tempmax on a day's record gives
# [min, mean, max] climate normals for that calendar date. Cached for a
# week per district (about 22 calls/day worst case, well under the free cap).
# https://www.visualcrossing.com/weather-api
# VISUAL_CROSSING_API_KEY=

# Google Maps Platform Weather API, NOT currently used by any feature.
# It was the original plan for the historical-averages tile above, but its
# "history" endpoint only covers the last 24 hours, not multi-year climate
# normals, so it can't actually do that job (Visual Crossing can). Left
# documented here in case a future feature genuinely fits it (its
# current+forecast+alerts bundle, not history). Do not wire it into
# anything without re-reading this note. If it is ever used: it REQUIRES
# billing enabled on the Google Cloud project even for the free 10k
# calls/month, and the real "never bill" guarantee is a hard quota
# override set by hand in Google Cloud Console (APIs and Services, then
# the Weather API's Quotas page) to a limit at or below the free
# allotment, for example 300/day. An in-app counter alone cannot guarantee
# zero spend on its own.
# https://developers.google.com/maps/documentation/weather
# GOOGLE_MAPS_API_KEY=

# Sentry error monitoring, leave unset to disable entirely (no SDK init,
# no source-map upload, no build-time plugin). Create a project at
# sentry.io, then use its Client Keys (DSN) page for these two, the DSN
# itself is not secret, both server and client use the same value:
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
#
# Optional, enables source-map upload during build for readable stack
# traces. Create at sentry.io, Settings, Auth Tokens (scope: project:releases).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ─── Analytics ───────────────────────────────────────────────

# Vercel Web Analytics and Speed Insights need no configuration here.
# They are cookieless and activate automatically on a Vercel deployment,
# with no effect on local development or other hosts.

# Google Analytics 4. Leave unset to disable entirely. Loads only after a
# visitor accepts non-essential cookies in the cookie banner, never before,
# since GA uses cookies for cross-session tracking (see
# docs/adr/ADR-006-no-user-data-phase-1.md for the consent-gating rule).
# https://analytics.google.com/ -> Admin -> Data Streams -> your stream -> Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Search engine verification ─────────────────────────────

# Google Search Console: https://search.google.com/search-console ->
# Add property -> ugandaweather.vercel.app -> HTML tag method -> copy just
# the content="..." value (not the whole tag).
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools: https://www.bing.com/webmasters -> Add site ->
# HTML Meta Tag method -> copy just the content="..." value. Bing also
# offers a one-click "Import from Google Search Console" option, which
# skips this entirely.
# BING_SITE_VERIFICATION=

# Lake fishing safety thresholds (defaults shown, apply to all four lakes)
# SAFETY_WAVE_DANGER_M=2.0
# SAFETY_WAVE_CAUTION_M=1.2
# SAFETY_WIND_DANGER_KPH=40
# SAFETY_WIND_CAUTION_KPH=25

# Cache TTL overrides in seconds (optional)
# CACHE_TTL_CURRENT=600
# CACHE_TTL_FORECAST=3600
# CACHE_TTL_ALERTS=300
# CACHE_TTL_MARINE=1800

# Luganda Beta feedback email delivery via Resend and Turnstile verification (optional; server-only secrets)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# LUGANDA_FEEDBACK_TO_EMAIL=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─── Hybrid Weather Advisor (Firebase AI Logic + App Check) ───
# Client-side Firebase Web SDK config for hybrid on-device and cloud inference.
# Leave unset to disable cloud fallback gracefully while keeping offline data intact.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AI_MODEL=gemini-3.8-flash
#
# App Check protects Firebase AI Logic quota from unauthorized clients.
# For production, provide your reCAPTCHA Enterprise site key:
# NEXT_PUBLIC_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local development or CI, set "true" (auto-generated in browser console)
# or a registered debug token UUID from Firebase Console -> App Check:
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# ─── Natural Voice Reader & Writer (Optional, Provider-Agnostic Server Config) ───
# Set VOICE_API_TOKEN (or SUNBIRD_API_TOKEN) to enable cloud neural TTS/STT.
# All endpoints, voices, models, limits, and timeouts are dynamically configurable:
# VOICE_API_TOKEN=
# VOICE_API_BASE_URL=https://api.sunbird.ai
# VOICE_SPEAKER_LG=
# VOICE_SPEAKER_EN=
# VOICE_ENGLISH_CLOUD_ENABLED=false
# VOICE_SPEAK_RATE_LIMIT=20
# VOICE_STT_RATE_LIMIT=15
# VOICE_MAX_TEXT_CHARS=600
# VOICE_MAX_AUDIO_BYTES=4194304
# VOICE_TIMEOUT_MS=25000
#
# Optional secondary server-side fallback for /api/v1/voice/speak English TTS.
# Not required when Firebase AI Logic client-side Neural TTS (firebase-tts.ts) is active;
# falls back to free device speech when unset or offline:
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=
# GEMINI_TTS_VOICE=

# Requests allowed per minute, per route, per IP address (default 240).
# API_RATE_LIMIT_PER_MINUTE=240

# Which forecast provider is asked first: weatherapi (default) or open-meteo.
# The other one becomes the backup, then Pirate Weather.
# WEATHER_PRIMARY_PROVIDER=weatherapi
