{
  "name": "uganda-weather",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-dev.mjs",
    "dev": "next dev",
    "dev:clean": "UW_DEV_CLEAN=1 node scripts/ensure-dev.mjs --force-clean && next dev",
    "prebuild": "node scripts/ensure-dev.mjs --check-config",
    "build": "next build",
    "postbuild": "node scripts/verify-build.mjs",
    "prestart": "node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:no-ai": "node scripts/check-no-ai.mjs",
    "check:copy": "node scripts/check-copy-style.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:native-version": "node scripts/check-native-version.mjs",
    "guards": "node scripts/check-no-ai.mjs && node scripts/check-copy-style.mjs && node scripts/check-security.mjs && node scripts/check-docs.mjs && node scripts/check-native-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:districts": "node scripts/build-districts.mjs",
    "smoke": "node scripts/smoke-districts.mjs",
    "prefetch:weather": "node scripts/prefetch-weather.mjs",
    "prefetch:alerts": "node scripts/prefetch-alerts.mjs",
    "prefetch:agriculture": "node scripts/prefetch-agriculture.mjs",
    "prefetch:air-quality": "node scripts/prefetch-air-quality.mjs",
    "push:dispatch": "node scripts/dispatch-storm-alert.mjs",
    "push:dispatch-alerts": "node scripts/dispatch-alerts-cron.mjs",
    "verify:unma": "node scripts/verify-unma-feed.mjs",
    "verify:styles": "node scripts/verify-styles.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "cap:sync": "node scripts/prepare-capacitor.mjs",
    "cap:prepare": "node scripts/prepare-capacitor.mjs",
    "cap:add:ios": "node scripts/prepare-capacitor.mjs ios",
    "cap:add:android": "node scripts/prepare-capacitor.mjs android",
    "cap:bundle:android": "node scripts/prepare-capacitor.mjs android && cd android && ./gradlew bundleRelease",
    "cap:build:android": "node scripts/prepare-capacitor.mjs android && cd android && ./gradlew assembleRelease",
    "cap:ios": "pnpm exec cap open ios",
    "cap:android": "pnpm exec cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.7",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@sentry/nextjs": "^10.64.0",
    "@tanstack/react-query": "^5.90.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^13.4.0",
    "framer-motion": "^12.23.12",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/cli": "^7.6.7",
    "@capacitor/ios": "^7.6.7",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
